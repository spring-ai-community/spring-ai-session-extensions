<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springaicommunity</groupId>
		<artifactId>spring-ai-session-extensions-parent</artifactId>
		<version>0.11.0</version>
	</parent>

	<artifactId>spring-ai-session-turn</artifactId>
	<packaging>jar</packaging>

	<name>Spring AI Session Extensions :: Turn</name>
	<description>Turn state for a Spring AI session, kept as events in the session log, with no dependency on the ChatClient</description>
	<url>https://github.com/spring-ai-community/spring-ai-session-extensions</url>

	<scm>
		<url>https://github.com/spring-ai-community/spring-ai-session-extensions</url>
		<connection>git://github.com/spring-ai-community/spring-ai-session-extensions.git</connection>
		<developerConnection>git@github.com:spring-ai-community/spring-ai-session-extensions.git</developerConnection>
	</scm>

	<licenses>
		<license>
			<name>Apache License 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Christian Tzolov</name>
		</developer>
	</developers>

	<dependencies>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-session</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The turn contract tests also run on Spring AI's JDBC store, with H2 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-session-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
